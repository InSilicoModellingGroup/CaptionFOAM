boundaryField
{    
    electrode
    {
        type            zeroGradient;
    }

    inlet
    {
        type            zeroGradient;
    }

    target
    {
        type            speciesWallFluxCorrected;
        temperature       TEle_K;
        reflectionFraction  0.0;
        value           uniform 0;
    }

    farfield
    {
        type            zeroGradient;
    }

    frontWedge
    {
        type            wedge;
    }

    backWedge
    {
        type            wedge;
    }
